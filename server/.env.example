# SkyVault server environment variables
# Copy to .env and fill in as needed. All keys are optional — defaults live in app/config.py.

# CORS — comma-separated list of allowed frontend origins (as JSON list in env)
# CORS_ORIGINS=["http://localhost:5173"]

# Gaia ingest
# GAIA_MAG_CUTOFF=8.0
# GAIA_PARQUET_PATH=data/gaia_dr3_g8.parquet

# Sky query defaults
# DEFAULT_MAG_LIMIT=6.5

# Production values live in deploy/cloudrun.env.yaml
# CORS_ORIGIN_REGEX=https://[a-z0-9-]+\.skyvault\.pages\.dev
# RATE_LIMIT_DATA_PER_MIN=120
# RATE_LIMIT_GEOCODE_PER_MIN=20
# TRUST_FORWARDED_FOR=false
# FORWARDED_FOR_INDEX=-1
